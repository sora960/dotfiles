{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "height": 30,
    "spacing": 6,

    "modules-left": [
        "group/hardware"
    ],
    "modules-center": [
        "clock",
        "custom/timer"
    ],
    "modules-right": [
        "mpris",
        "group/network",
        "group/audio",
        "custom/cam"
    ],

    /* --- HARDWARE GROUP --- */
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature"
        ]
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB",
        "interval": 2
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": "󰈸 {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "Ryzen Die: {temperatureC}°C",
        "interval": 2
    },

    /* --- CENTER MODULES --- */
    "clock": {
        "format": "󱑂 {:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/timer": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/lucy/.config/hypr/scripts/timer.sh status",
        "on-click": "/home/lucy/.config/hypr/scripts/timer.sh menu",
        "interval": 1
    },

    /* --- RIGHT MODULES & PERIPHERALS --- */
    "mpris": {
        "format": "󰎆 {title} - {artist}",
        "format-paused": "󰏤 {title} - {artist}",
        "max-length": 35,
        "tooltip": false,
        "interval": 2
    },

    /* Dual Network Capsule: Displays both Ethernet & Wi-Fi side-by-side */
    "group/network": {
        "orientation": "horizontal",
        "modules": [
            "network#eth",
            "network#wifi"
        ]
    },

    "network#eth": {
        "interface": "enp5s0",
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "format-disconnected": "󰈂",
        "tooltip-format-ethernet": "Ethernet: enp5s0\nIP: {ipaddr}/{cidr}\nDown: {bandwidthDownBytes} | Up: {bandwidthUpBytes}",
        "interval": 2,
        "on-click": "/home/lucy/.config/waybar/scripts/eth-toggle.sh",
        "on-click-right": "uwsm app -- kitty --class float-term -e nmtui"
    },

    "network#wifi": {
        "interface": "wlp1s0f0u1",
        "format-wifi": "󰖩 {essid}",
        "format-disconnected": "󰖪 Off",
        "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}",
        "interval": 2,
        "on-click": "/home/lucy/.config/waybar/scripts/wifi-toggle.sh",
        "on-click-right": "/home/lucy/.config/waybar/scripts/wifi-select-rofi.sh"
    },

    /* Audio & Mic Unit */
    "group/audio": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#source"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip": false,
        "on-click": "pavucontrol"
    },

    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "tooltip": true,
        "tooltip-format": "Source: {desc}\nLeft-click: Toggle Mute\nRight-click: Peripheral Hub\nMiddle-click: Live VU Meter",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "/home/lucy/.config/waybar/staging/periph-menu.sh",
        "on-click-middle": "/home/lucy/.config/waybar/staging/mic-check.sh",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    /* Dynamic Camera Tattletale */
    "custom/cam": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/lucy/.config/waybar/staging/cam-tattletale.sh",
        "interval": 1,
        "on-click": "/home/lucy/.config/waybar/staging/cam-preview.sh",
        "tooltip": true
    }
}
