#!/usr/bin/env python3

from pathlib import Path
import subprocess

DOC = Path.home() / "dotfiles/docs/developer-environment.md"

def run(*args):
    return subprocess.run(
        args,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()

info = {}

for line in run("pacman", "-Qi", "composer").splitlines():
    if " : " in line:
        key, value = line.split(" : ", 1)
        info[key.strip()] = value.strip()

version = info["Version"]
source = info["Installed From"]
cli = run("composer", "--version")

text = DOC.read_text()

start = text.index("## 6.1 Composer")
end = text.index("# 7. Laravel Development")

section = (
    "## 6.1 Composer\n\n"
    "Composer provides dependency management for PHP projects.\n\n"
    "| Tool | Package | Command | Version | Repository | Status | Purpose |\n"
    "| ---- | ------- | ------- | ------- | ---------- | ------ | ------- |\n"
    f"| Composer | `composer` | `composer` | {version} | `{source}` | Installed | PHP dependency management |\n\n"
    "Verification:\n\n"
    "    composer --version\n\n"
    "Current executable:\n\n"
    f"    {cli}\n\n"
    "Package verification:\n\n"
    "    pacman -Qi composer\n\n"
    "Composer is installed globally because it is the dependency manager "
    "for PHP development.\n\n"
    "---\n\n"
)

DOC.write_text(text[:start] + section + text[end:])

print("Updated:", DOC)
print("Composer:", version)
print("Source:", source)
print("Executable:", cli)
